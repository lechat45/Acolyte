# ⚠️ GitHub Pages IGNORE ce fichier : il n'est lu que par Cloudflare Pages
# ou Netlify. Le site étant aujourd'hui sur GitHub Pages, les protections
# ci-dessous ne s'appliquent PAS encore — c'est pour ça que l'essentiel est
# aussi posé dans la balise CSP d'index.html, qui elle marche partout.

# Protections appliquées à toutes les pages
/*
  # Empêche d'enfermer le site dans une iframe (clickjacking : un faux bouton
  # posé par-dessus le vrai, et l'utilisateur clique sans le savoir)
  X-Frame-Options: DENY
  # Interdit au navigateur de « deviner » un type de fichier différent
  X-Content-Type-Options: nosniff
  # L'adresse de la page ne fuite pas vers les sites tiers qu'on appelle
  Referrer-Policy: strict-origin-when-cross-origin
  # On ne demande aucun de ces capteurs : autant les refuser d'office
  Permissions-Policy: camera=(self), geolocation=(self), microphone=(), payment=(), usb=()
  # Force HTTPS pendant 2 ans, sous-domaines compris
  Strict-Transport-Security: max-age=63072000; includeSubDomains

# En-têtes de cache (Cloudflare Pages / Netlify)
# HTML/JS/CSS/SW : toujours revalidés → les mises à jour arrivent immédiatement
# (le service worker sert la version en cache en secours hors-ligne)
/index.html
  Cache-Control: no-cache

# Panel admin : jamais mis en cache, jamais indexé
/admin.html
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
/*.js
  Cache-Control: no-cache
/*.css
  Cache-Control: no-cache
/sw.js
  Cache-Control: no-cache
/manifest.json
  Cache-Control: no-cache

# Images de contenu : cache long, elles ne changent jamais sous le même nom
/*.png
  Cache-Control: public, max-age=31536000, immutable
/*.svg
  Cache-Control: public, max-age=31536000, immutable
/*.webp
  Cache-Control: public, max-age=31536000, immutable

# ⚠️ EXCEPTION — les icônes de marque. Elles portent un nom FIXE (le manifeste
# et les balises <link> y renvoient) et sont donc remplacées SUR PLACE quand le
# logo change. Avec « immutable » ci-dessus, un visiteur garderait l'ancienne
# icône jusqu'à un an, sans même revalider : c'est exactement le piège dans
# lequel on tombe le jour où le site quitte GitHub Pages. Une journée de cache,
# puis revalidation.
# (Ces règles viennent APRÈS le joker : à égalité, c'est la plus spécifique et
#  la plus tardive qui gagne.)
/favicon.ico
  Cache-Control: public, max-age=86400, must-revalidate
/apple-touch-icon.png
  Cache-Control: public, max-age=86400, must-revalidate
/icon-192.png
  Cache-Control: public, max-age=86400, must-revalidate
/icon-512.png
  Cache-Control: public, max-age=86400, must-revalidate
/icon-maskable-192.png
  Cache-Control: public, max-age=86400, must-revalidate
/icon-maskable-512.png
  Cache-Control: public, max-age=86400, must-revalidate
/og-image.png
  Cache-Control: public, max-age=86400, must-revalidate
